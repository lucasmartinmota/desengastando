  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"icon_key\" TEXT NOT NULL, \"color\" INTEGER NOT NULL, \"type\" TEXT NOT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, UNIQUE (\"name\", \"type\"));"
        }
      ]
    },
    {
      "name": "recurrences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurrences\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"amount_cents\" INTEGER NOT NULL CHECK(\"amount_cents\" > 0), \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"description\" TEXT NULL, \"payment_method\" TEXT NULL, \"day_of_month\" INTEGER NOT NULL CHECK(\"day_of_month\" BETWEEN 1 AND 31), \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), \"last_generated_month\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"amount_cents\" INTEGER NOT NULL CHECK(\"amount_cents\" > 0), \"date\" INTEGER NOT NULL, \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"description\" TEXT NULL, \"payment_method\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"recurrence_id\" INTEGER NULL REFERENCES recurrences (id) ON DELETE SET NULL);"
        }
      ]
    },
    {
      "name": "budgets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE CASCADE, \"limit_cents\" INTEGER NOT NULL CHECK(\"limit_cents\" > 0), PRIMARY KEY (\"category_id\"));"
        }
      ]
    }
  ]
